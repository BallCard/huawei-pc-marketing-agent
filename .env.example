# 复制为 .env 后按需修改；不要把真实 .env 提交到仓库
LLM_BASE_URL=http://127.0.0.1:8045/v1
LLM_API_KEY=

WRITER_MODEL=gemini-3.8-flash-high
FAST_MODEL=gemini-3.8-flash-low
JUDGE_MODEL=gemini-3.8-flash-medium
LLM_TIMEOUT=300
# 整次创作总预算，覆盖慢速质量模型的写作、独立评审和一次修订/复审；这是上限
GENERATION_BUDGET_SECONDS=240
# DeepSeek 演示建议 disabled；兼容接口不支持此字段时使用 auto
LLM_THINKING=auto

# 可单独给需求解析/推荐/内容策划接魔搭（未配置则复用上面的接口）
# FAST_MODEL=Qwen/Qwen3.5-35B-A3B
# FAST_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# FAST_LLM_API_KEY=在部署平台 Secret 中填写魔搭推理令牌
# FAST_LLM_THINKING=auto
# FAST_LLM_EXTRA_BODY={"enable_thinking":false}
# 写作与审核也支持 WRITER_LLM_* / JUDGE_LLM_* 同名覆盖

# 知识库目录（默认读项目内 data/kb）
KB_DIR=
CACHE_DIR=
KB_BACKEND=local
# 缺少整机图时自动检索华为官网；图片须通过完整型号与视觉检查
WEB_IMAGE_SEARCH=1
WEB_IMAGE_TIMEOUT=25
# 复用 FAST 接口，默认 FAST_MODEL；必须支持图片输入，不支持时保留缺图
IMAGE_VERIFY_MODEL=

# 整张门店海报：魔搭异步生图，复用已有魔搭推理令牌；密钥仅在服务端保存
POSTER_IMAGE_ENABLED=1
POSTER_IMAGE_PROVIDER=modelscope
POSTER_IMAGE_AUTH_MODE=bearer
POSTER_IMAGE_BASE_URL=https://api-inference.modelscope.cn/v1
POSTER_IMAGE_API_KEY=
POSTER_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2511
POSTER_REVIEW_MODEL=Qwen/Qwen3.5-35B-A3B
POSTER_REVIEW_BASE_URL=https://api-inference.modelscope.cn/v1
POSTER_REVIEW_API_KEY=
POSTER_IMAGE_TIMEOUT=600
POSTER_REVIEW_TIMEOUT=60
# 留空默认 JOB_DB 同级 posters/，部署需放持久目录
POSTER_DIR=

# 网页生图反代（独立自托管服务）；配好后再将 PROVIDER 改为 gemini_web_proxy
# POSTER_IMAGE_BASE_URL=https://你的反代域名/openai/v1
# POSTER_IMAGE_MODEL=gemini-3-pro
# POSTER_IMAGE_API_KEY=反代自己的访问密钥，不是 Google Cookie
# POSTER_REVIEW_API_KEY=魔搭推理令牌，审核不经过网页反代
# ChatGPT 网页反代：gpt-web-gateway（支持 reference_images[] 与上传确认）
# POSTER_IMAGE_PROVIDER=chatgpt_web_proxy
# POSTER_IMAGE_BASE_URL=https://你的反代域名/v1
# POSTER_IMAGE_MODEL=chatgpt-web
# 反代若部署在魔搭 ms.show，使用 basic，避免被入口当作 SDK Token 拦截
# POSTER_IMAGE_AUTH_MODE=basic
# 美国 VPS 主动连接魔搭，不开放反代公网端口；独立任务密钥不是 ChatGPT 会话
# POSTER_IMAGE_PROVIDER=private_worker
# POSTER_IMAGE_MODEL=chatgpt-web
POSTER_WORKER_TOKEN=

# 本机访问无需账号；对外监听时两项都必须配置，使用 HTTPS
HOST=127.0.0.1
PORT=7860
AUTH_USERNAME=
AUTH_PASSWORD=
# HTTPS 部署设 1；仅在本机 HTTP 测试登录时设 0
# COOKIE_SECURE=1
MAX_CONCURRENT_JOBS=1
# 留空默认 data/state/jobs.sqlite3；部署时必须放到持久卷，单进程运行
JOB_DB=
