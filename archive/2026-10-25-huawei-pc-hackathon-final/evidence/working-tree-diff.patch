+/* ---- Full-screen screenshot boards (one after each feature slide) ---- */
+.shot-board.is-active {
+  display: flex;
+  flex-direction: column;
+}
+
+.shot-head {
+  flex: 0 0 auto;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(220px, 430px);
+  gap: 24px;
+  align-items: end;
+  padding-bottom: 14px;
+  margin-bottom: 18px;
+  border-bottom: 1px solid var(--line);
+}
+
+.shot-head h2 {
+  margin: 4px 0 0;
+  font-size: clamp(22px, 2.1vw, 32px);
+  line-height: 1.2;
+}
+
+.shot-head h2 em {
+  display: block;
+  margin-top: 6px;
+  color: var(--muted);
+  font: 500 14px/1.5 var(--sans);
+  font-style: normal;
+  letter-spacing: .02em;
+}
+
+.shot-lede {
+  margin: 0;
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.75;
+  text-align: right;
+}
+
+.shot-stage {
+  flex: 1 1 auto;
+  min-height: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 236px;
+  gap: 26px;
+  align-items: stretch;
+}
+
+.shot-stage-main {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 0;
+  min-width: 0;
+}
+
+.shot-frame {
+  position: relative;
+  height: 100%;
+  aspect-ratio: var(--shot-ratio, 8 / 5);
+  max-width: 100%;
+  margin: 0;
+  background: var(--white);
+  box-shadow: 0 0 0 1px var(--line), 13px 15px 0 rgba(23, 23, 23, .05);
+}
+
+.shot-frame img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  background: #f4f1eb;
+}
+
+.shot-pin {
+  position: absolute;
+  left: var(--x, 50%);
+  top: var(--y, 50%);
+  width: 26px;
+  height: 26px;
+  transform: translate(-50%, -50%);
+  border-radius: 50%;
+  background: var(--red);
+  color: #fff;
+  box-shadow: 0 0 0 4px rgba(245, 242, 236, .92), 0 6px 16px rgba(23, 23, 23, .22);
+  z-index: 3;
+}
+
+.shot-pin b {
+  display: grid;
+  place-items: center;
+  width: 100%;
+  height: 100%;
+  font: 600 11px/1 var(--mono);
+}
+
+.shot-pin::after {
+  content: "";
+  position: absolute;
+  inset: -10px;
+  border: 1px solid rgba(200, 16, 46, .38);
+  border-radius: 50%;
+}
+
+.shot-pin-label {
+  position: absolute;
+  left: calc(100% + 12px);
+  top: 50%;
+  transform: translateY(-50%);
+  padding: 5px 9px;
+  background: rgba(255, 255, 255, .96);
+  border: 1px solid rgba(23, 23, 23, .14);
+  color: #26231f;
+  font-size: 10.5px;
+  font-weight: 600;
+  letter-spacing: .02em;
+  white-space: nowrap;
+  box-shadow: 0 3px 10px rgba(23, 23, 23, .08);
+}
+
+.shot-pin.is-flip .shot-pin-label {
+  left: auto;
+  right: calc(100% + 12px);
+}
+
+.shot-notes {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 20px;
+  margin: 0;
+  padding: 0 0 0 20px;
+  border-left: 1px solid var(--line);
+  list-style: none;
+}
+
+.shot-notes li {
+  display: grid;
+  grid-template-columns: 22px minmax(0, 1fr);
+  gap: 10px;
+}
+
+.shot-notes b {
+  color: var(--red);
+  font: 600 11px/1.6 var(--mono);
+  letter-spacing: .08em;
+}
+
+.shot-notes strong {
+  display: block;
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+.shot-notes span {
+  display: block;
+  margin-top: 4px;
+  color: var(--muted);
+  font-size: 11.5px;
+  line-height: 1.7;
+}
+
+@media (max-width: 1080px) {
+  .shot-board.is-active { display: block; }
+  .shot-head { grid-template-columns: 1fr; gap: 8px; align-items: start; }
+  .shot-lede { text-align: left; }
+  .shot-stage { display: block; }
+  .shot-stage-main { display: block; }
+  .shot-frame { width: 100%; max-width: 880px; height: auto; }
+  .shot-notes { margin-top: 26px; padding-left: 0; border-left: 0; }
+}
+
+@media (max-width: 680px) {
+  .shot-head h2 { font-size: 23px; }
+  .shot-head h2 em { font-size: 13px; }
+  .shot-pin { width: 22px; height: 22px; }
+  .shot-pin-label { display: none; }
+}
+
+/* ---- Research evidence slide: how many cases we read, what we kept ---- */
+.research-evidence { padding-top: clamp(26px, 4vh, 48px); }
+
+.research-evidence .slide-topline {
+  align-items: start;
+  gap: 4vw;
+  padding-right: 2vw;
+}
+
+.research-evidence .slide-topline h2 {
+  margin-bottom: 0;
+  font-size: clamp(28px, 3.1vw, 44px);
+}
+
+.research-evidence .slide-topline > p {
+  margin: 6px 0 0;
+  font-size: 12.5px;
+  line-height: 1.75;
+}
+
+.research-metrics {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 12px;
+  margin: 22px 0 16px 6vw;
+}
+
+.research-metrics article {
+  padding: 15px 17px 14px;
+  background: var(--white);
+  border: 1px solid var(--line);
+  border-top: 2px solid rgba(200, 16, 46, .22);
+}
+
+.research-metrics span {
+  color: var(--red);
+  font: 10px var(--mono);
+  letter-spacing: .08em;
+}
+
+.research-metrics b {
+  display: flex;
+  align-items: baseline;
+  gap: 7px;
+  margin: 8px 0 7px;
+  font: 700 clamp(30px, 2.6vw, 39px)/1 var(--mono);
+  letter-spacing: -.03em;
+}
+
+.research-metrics b small {
+  color: var(--muted);
+  font: 500 11px var(--sans);
+  letter-spacing: 0;
+}
+
+.research-metrics p {
+  margin: 0;
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.6;
+}
+
+.research-metric-accent {
+  border-top-color: var(--red);
+  background: #fbf7ef;
+}
+
+.research-metric-accent b { color: var(--red); }
+
+.research-decisions {
+  display: grid;
+  grid-template-columns: 1.04fr .96fr;
+  gap: 14px;
+  margin-left: 6vw;
+}
+
+.research-panel {
+  padding: 15px 17px;
+  background: var(--white);
+  border: 1px solid var(--line);
+}
+
+.research-panel-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 12px;
+  padding-bottom: 9px;
+  border-bottom: 1px solid var(--line);
+}
+
+.research-panel-head span {
+  color: var(--red);
+  font: 10px var(--mono);
+  letter-spacing: .08em;
+}
+
+.research-panel-head b { font-size: 13px; }
+
+.research-panel ul {
+  display: grid;
+  gap: 7px;
+  margin: 10px 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.research-panel li {
+  display: grid;
+  grid-template-columns: 86px minmax(0, 1fr);
+  gap: 10px;
+  align-items: baseline;
+}
+
+.research-panel li b {
+  color: var(--ink);
+  font: 600 10px var(--mono);
+  letter-spacing: .04em;
+}
+
+.research-panel li span {
+  font-size: 11.5px;
+  line-height: 1.55;
+}
+
+.research-panel li em {
+  display: block;
+  margin-top: 2px;
+  color: var(--muted);
+  font-size: 10.5px;
+  font-style: normal;
+}
+
+.research-more {
+  display: block;
+  margin-top: 9px;
+  color: var(--muted);
+  font-size: 10.5px;
+  line-height: 1.55;
+}
+
+.research-note {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 6px 14px;
+  margin: 15px 0 0 6vw;
+  padding: 10px 14px;
+  background: #fbf7ef;
+  border-left: 2px solid var(--red);
+}
+
+.research-note span {
+  color: var(--red);
+  font: 10px var(--mono);
+  letter-spacing: .08em;
+}
+
+.research-note b { font-size: 12.5px; }
+
+.research-note small {
+  color: var(--muted);
+  font-size: 10.5px;
+}
+
+@media (max-width: 1080px) {
+  .research-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-left: 5vw; }
+  .research-decisions { grid-template-columns: 1fr; margin-left: 5vw; }
+  .research-note { margin-left: 5vw; }
+}
+
+@media (max-width: 680px) {
+  .research-metrics { grid-template-columns: 1fr; margin-left: 0; }
+  .research-decisions { margin-left: 0; }
+  .research-note { margin-left: 0; }
+  .research-evidence .slide-topline { padding-left: 0; }
+}
+
+/* Short projector screens: keep the opening slide inside one viewport. */
+@media (max-height: 800px) and (min-width: 1081px) {
+  .slide-opening { padding-top: clamp(20px, 3vh, 32px); }
+  .slide-opening h1 { font-size: clamp(38px, 4.2vw, 58px); }
+  .slide-opening .deck-lead { font-size: 15px; line-height: 1.75; }
+}
+
+/* Three-up scene-generated poster boards. */
+.shot-trio {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 16px;
+  align-items: center;
+  height: 100%;
+  min-height: 0;
+}
+
+.shot-trio-item { min-width: 0; }
+
+.shot-trio .shot-frame {
+  width: 100%;
+  height: auto;
+  aspect-ratio: var(--shot-ratio);
+  box-shadow: 0 0 0 1px var(--line), 8px 10px 0 rgba(23, 23, 23, .05);
+}
+
+.shot-trio .shot-frame img { height: 100%; }
+
+.shot-trio-cap {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  margin: 10px 0 0;
+  color: var(--muted);
+  font-size: 10px;
+  line-height: 1.45;
+}
+
+.shot-trio-cap b {
+  color: var(--red);
+  font: 600 10px var(--mono);
+  letter-spacing: .06em;
+}
+
+@media (max-width: 680px) {
+  .shot-trio { grid-template-columns: 1fr; gap: 22px; }
+}
